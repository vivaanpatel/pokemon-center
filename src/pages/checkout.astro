---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Checkout — PokéCard Market" description="Complete your Pokémon card purchase securely.">
  <div class="checkout-page">
    <div class="container">
      <div class="checkout-header">
        <a href="/cart" class="back-link">← Back to Cart</a>
        <h1 class="page-title">Checkout</h1>
        <div class="secure-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Secure Checkout
        </div>
      </div>

      <!-- Steps -->
      <div class="checkout-steps">
        <div class="step active" id="step-indicator-1">
          <div class="step-num">1</div>
          <span>Shipping</span>
        </div>
        <div class="step-line"></div>
        <div class="step" id="step-indicator-2">
          <div class="step-num">2</div>
          <span>Payment</span>
        </div>
        <div class="step-line"></div>
        <div class="step" id="step-indicator-3">
          <div class="step-num">3</div>
          <span>Review</span>
        </div>
      </div>

      <div class="checkout-layout">
        <!-- Form -->
        <div class="checkout-form-section">

          <!-- Step 1: Shipping -->
          <div class="checkout-step" id="step-1">
            <h2 class="step-title">Shipping Information</h2>
            <form class="checkout-form" id="shipping-form" novalidate>
              <div class="form-row">
                <div class="form-group">
                  <label for="first-name">First Name *</label>
                  <input type="text" id="first-name" name="firstName" placeholder="Ash" required autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="last-name">Last Name *</label>
                  <input type="text" id="last-name" name="lastName" placeholder="Ketchum" required autocomplete="family-name" />
                </div>
              </div>
              <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="ash@pokecenter.com" required autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="address">Street Address *</label>
                <input type="text" id="address" name="address" placeholder="1 Pokémon Way" required autocomplete="street-address" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="city">City *</label>
                  <input type="text" id="city" name="city" placeholder="Pallet Town" required autocomplete="address-level2" />
                </div>
                <div class="form-group">
                  <label for="state">State / Province *</label>
                  <input type="text" id="state" name="state" placeholder="Kanto" required autocomplete="address-level1" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="zip">ZIP / Postal Code *</label>
                  <input type="text" id="zip" name="zip" placeholder="00001" required autocomplete="postal-code" />
                </div>
                <div class="form-group">
                  <label for="country">Country *</label>
                  <select id="country" name="country" required autocomplete="country">
                    <option value="US">United States</option>
                    <option value="CA">Canada</option>
                    <option value="GB">United Kingdom</option>
                    <option value="AU">Australia</option>
                    <option value="JP">Japan</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>

              <!-- Shipping method -->
              <div class="form-group">
                <label class="form-label-plain">Shipping Method</label>
                <div class="shipping-options">
                  <label class="shipping-option">
                    <input type="radio" name="shipping" value="standard" checked id="ship-standard" />
                    <div class="ship-option-content">
                      <div>
                        <div class="ship-name">Standard Shipping</div>
                        <div class="ship-time">5–8 business days</div>
                      </div>
                      <div class="ship-price" id="ship-standard-price">$4.99</div>
                    </div>
                  </label>
                  <label class="shipping-option">
                    <input type="radio" name="shipping" value="express" id="ship-express" />
                    <div class="ship-option-content">
                      <div>
                        <div class="ship-name">Express Shipping</div>
                        <div class="ship-time">2–3 business days</div>
                      </div>
                      <div class="ship-price">$12.99</div>
                    </div>
                  </label>
                  <label class="shipping-option">
                    <input type="radio" name="shipping" value="overnight" id="ship-overnight" />
                    <div class="ship-option-content">
                      <div>
                        <div class="ship-name">Overnight Shipping</div>
                        <div class="ship-time">Next business day</div>
                      </div>
                      <div class="ship-price">$24.99</div>
                    </div>
                  </label>
                </div>
              </div>

              <button type="submit" class="btn btn-primary step-btn" id="to-payment-btn">
                Continue to Payment
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </form>
          </div>

          <!-- Step 2: Payment -->
          <div class="checkout-step hidden" id="step-2">
            <h2 class="step-title">Payment Details</h2>
            <div class="payment-notice">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Your payment is encrypted and secure. We never store card details.
            </div>

            <form class="checkout-form" id="payment-form" novalidate>
              <!-- Card type icons -->
              <div class="card-types">
                <div class="card-type-icon">💳 Visa</div>
                <div class="card-type-icon">💳 Mastercard</div>
                <div class="card-type-icon">💳 Amex</div>
                <div class="card-type-icon">💳 Discover</div>
              </div>

              <div class="form-group">
                <label for="card-name">Name on Card *</label>
                <input type="text" id="card-name" name="cardName" placeholder="Ash Ketchum" required />
              </div>
              <div class="form-group">
                <label for="card-num">Card Number *</label>
                <div class="card-input-wrap">
                  <input type="text" id="card-num" name="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required />
                  <span class="card-icon">💳</span>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="card-expiry">Expiry Date *</label>
                  <input type="text" id="card-expiry" name="expiry" placeholder="MM/YY" maxlength="5" required />
                </div>
                <div class="form-group">
                  <label for="card-cvv">CVV *</label>
                  <input type="text" id="card-cvv" name="cvv" placeholder="123" maxlength="4" required />
                </div>
              </div>

              <label class="billing-check">
                <input type="checkbox" id="same-billing" checked />
                <span>Billing address same as shipping</span>
              </label>

              <div class="form-row step-actions">
                <button type="button" class="btn btn-outline step-btn" id="back-to-shipping">← Back</button>
                <button type="submit" class="btn btn-primary step-btn" id="to-review-btn">
                  Review Order
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              </div>
            </form>
          </div>

          <!-- Step 3: Review -->
          <div class="checkout-step hidden" id="step-3">
            <h2 class="step-title">Review Your Order</h2>
            <div id="review-items" class="review-items"></div>
            <div class="form-row step-actions" style="margin-top:28px">
              <button class="btn btn-outline step-btn" id="back-to-payment">← Back</button>
              <button class="btn btn-primary step-btn" id="place-order-btn">
                🎉 Place Order
              </button>
            </div>
          </div>

          <!-- Step 4: Success -->
          <div class="checkout-step hidden success-step" id="step-success">
            <div class="success-icon">✅</div>
            <h2>Order Placed Successfully!</h2>
            <p>Thank you for your order! You'll receive a confirmation email shortly. Your cards will be authenticated and shipped within 1–2 business days.</p>
            <div class="success-actions">
              <a href="/shop" class="btn btn-primary" id="continue-shopping-success">Continue Shopping</a>
              <a href="/" class="btn btn-outline" id="go-home-success">Go Home</a>
            </div>
          </div>

        </div>

        <!-- Order Summary Sidebar -->
        <div class="checkout-summary" id="checkout-summary">
          <h3 class="summary-title">Order Summary</h3>
          <div id="checkout-summary-items" class="summary-items"></div>
          <div class="summary-divider"></div>
          <div class="summary-rows">
            <div class="summary-row">
              <span>Subtotal</span>
              <span id="co-subtotal">$0.00</span>
            </div>
            <div class="summary-row">
              <span>Shipping</span>
              <span id="co-shipping">$4.99</span>
            </div>
          </div>
          <div class="summary-total">
            <span>Total</span>
            <span id="co-total">$0.00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { cards } from '../data/cards';

  // Load cart
  const cart = JSON.parse(localStorage.getItem('pokemon-cart') || '[]');
  let subtotal = 0;

  // Populate summary
  const summaryItems = document.getElementById('checkout-summary-items')!;
  const reviewItems = document.getElementById('review-items')!;

  cart.forEach((item: {id:string, qty:number}) => {
    const card = cards.find(c => c.id === item.id);
    if (!card) return;
    const lineTotal = card.price * item.qty;
    subtotal += lineTotal;

    const summaryItem = document.createElement('div');
    summaryItem.className = 'co-summary-item';
    summaryItem.innerHTML = `
      <img src="${card.image}" alt="${card.name}" class="co-item-img" />
      <div class="co-item-info">
        <div class="co-item-name">${card.name}</div>
        <div class="co-item-meta">×${item.qty} • ${card.condition}</div>
      </div>
      <div class="co-item-price">$${lineTotal.toFixed(2)}</div>
    `;
    summaryItems.appendChild(summaryItem);

    const reviewItem = document.createElement('div');
    reviewItem.className = 'cart-item';
    reviewItem.innerHTML = `
      <div class="cart-item-img-wrap"><img src="${card.image}" alt="${card.name}" class="cart-item-img" /></div>
      <div class="cart-item-info">
        <div class="cart-item-name">${card.name}</div>
        <div class="cart-item-meta">${card.set} • ${card.rarity} • ${card.condition}</div>
        <div class="cart-item-line" style="margin-top:8px; color: var(--yellow); font-weight:800">$${lineTotal.toFixed(2)} (×${item.qty})</div>
      </div>
    `;
    reviewItems.appendChild(reviewItem);
  });

  let shippingCost = 4.99;

  function updateSummaryTotals() {
    (document.getElementById('co-subtotal') as HTMLElement).textContent = `$${subtotal.toFixed(2)}`;
    (document.getElementById('co-shipping') as HTMLElement).textContent = shippingCost === 0 ? 'FREE' : `$${shippingCost.toFixed(2)}`;
    (document.getElementById('co-total') as HTMLElement).textContent = `$${(subtotal + shippingCost).toFixed(2)}`;
  }

  updateSummaryTotals();

  // Shipping radio change
  document.querySelectorAll('input[name="shipping"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (val === 'standard') shippingCost = subtotal >= 50 ? 0 : 4.99;
      else if (val === 'express') shippingCost = 12.99;
      else shippingCost = 24.99;
      updateSummaryTotals();
    });
  });

  if (subtotal >= 50) {
    (document.getElementById('ship-standard-price') as HTMLElement).textContent = 'FREE';
    shippingCost = 0;
    updateSummaryTotals();
  }

  // Step navigation
  function goToStep(n: number) {
    document.querySelectorAll('.checkout-step').forEach((el, i) => {
      (el as HTMLElement).classList.toggle('hidden', i !== n - 1);
    });
    document.querySelectorAll('.step').forEach((el, i) => {
      el.classList.toggle('active', i <= n - 1);
      el.classList.toggle('done', i < n - 1);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Format card number
  const cardNumInput = document.getElementById('card-num') as HTMLInputElement;
  cardNumInput?.addEventListener('input', () => {
    let val = cardNumInput.value.replace(/\D/g, '').slice(0, 16);
    cardNumInput.value = val.replace(/(.{4})/g, '$1 ').trim();
  });

  // Format expiry
  const expiryInput = document.getElementById('card-expiry') as HTMLInputElement;
  expiryInput?.addEventListener('input', () => {
    let val = expiryInput.value.replace(/\D/g, '').slice(0, 4);
    if (val.length >= 2) val = val.slice(0, 2) + '/' + val.slice(2);
    expiryInput.value = val;
  });

  // Shipping form submit
  document.getElementById('shipping-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    if (form.checkValidity()) goToStep(2);
    else form.reportValidity();
  });

  document.getElementById('back-to-shipping')?.addEventListener('click', () => goToStep(1));

  // Payment form submit
  document.getElementById('payment-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    if (form.checkValidity()) goToStep(3);
    else form.reportValidity();
  });

  document.getElementById('back-to-payment')?.addEventListener('click', () => goToStep(2));

  // Place order
  document.getElementById('place-order-btn')?.addEventListener('click', () => {
    localStorage.removeItem('pokemon-cart');
    window.dispatchEvent(new Event('cart-updated'));
    // Show success
    document.querySelectorAll('.checkout-step').forEach(el => el.classList.add('hidden'));
    document.getElementById('step-success')?.classList.remove('hidden');
    document.getElementById('checkout-summary')?.style.setProperty('display', 'none');
  });
</script>

<style>
  .checkout-page { padding-top: 100px; padding-bottom: 80px; min-height: 100vh; }

  .checkout-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .back-link:hover { color: var(--yellow); }

  .page-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    flex: 1;
  }

  .secure-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #22c55e;
    font-weight: 600;
  }

  /* Steps */
  .checkout-steps {
    display: flex;
    align-items: center;
    margin-bottom: 40px;
    gap: 0;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    transition: color var(--transition);
  }

  .step.active { color: var(--white); }
  .step.done { color: var(--yellow); }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--navy-mid);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    transition: all var(--transition);
    flex-shrink: 0;
  }

  .step.active .step-num {
    background: var(--yellow);
    color: var(--navy);
    border-color: var(--yellow);
  }

  .step.done .step-num {
    background: var(--yellow);
    color: var(--navy);
    border-color: var(--yellow);
  }

  .step-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    min-width: 40px;
    margin: 0 8px;
  }

  /* Layout */
  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
    align-items: start;
  }

  /* Form */
  .checkout-step { }
  .checkout-step.hidden { display: none; }

  .step-title {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
  }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }

  .form-group label, .form-label-plain {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-group input,
  .form-group select {
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    color: var(--white);
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    transition: border-color var(--transition);
    width: 100%;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: rgba(255,215,0,0.5);
    box-shadow: 0 0 0 3px rgba(255,215,0,0.08);
  }

  .form-group input::placeholder { color: var(--text-muted); }
  .form-group input:invalid:not(:placeholder-shown) { border-color: #FF6B6B; }

  .form-group select { cursor: pointer; appearance: none; }
  .form-group select option { background: var(--navy-light); }

  /* Shipping options */
  .shipping-options { display: flex; flex-direction: column; gap: 10px; }

  .shipping-option {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    cursor: pointer;
    transition: all var(--transition);
  }

  .shipping-option:has(input:checked) {
    border-color: rgba(255,215,0,0.4);
    background: rgba(255,215,0,0.05);
  }

  .shipping-option input[type="radio"] { accent-color: var(--yellow); flex-shrink: 0; }

  .ship-option-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 12px;
  }

  .ship-name { font-size: 0.9rem; font-weight: 600; color: var(--white); }
  .ship-time { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }
  .ship-price { font-size: 0.95rem; font-weight: 700; color: var(--yellow); white-space: nowrap; }

  /* Payment */
  .payment-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 0.8rem;
    color: #22c55e;
    margin-bottom: 4px;
  }

  .card-types {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card-type-icon {
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .card-input-wrap { position: relative; }
  .card-input-wrap input { padding-right: 40px; }
  .card-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1rem;
    pointer-events: none;
  }

  .billing-check {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-body);
  }

  .billing-check input { accent-color: var(--yellow); width: 16px; height: 16px; }

  .step-actions { gap: 12px; }

  .step-btn {
    flex: 1;
    justify-content: center;
    height: 48px;
    font-size: 0.95rem;
  }

  /* Review */
  .review-items { display: flex; flex-direction: column; gap: 12px; }

  .cart-item {
    display: flex;
    gap: 16px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
  }

  .cart-item-img-wrap {
    width: 70px;
    height: 70px;
    background: rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cart-item-img { width: 55px; height: 55px; object-fit: contain; }

  .cart-item-info { flex: 1; }
  .cart-item-name { font-size: 1rem; font-weight: 700; color: var(--white); }
  .cart-item-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; }

  /* Success */
  .success-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 60px 24px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .success-icon { font-size: 4rem; margin-bottom: 20px; }

  .success-step h2 {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }

  .success-step p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 440px;
    margin-bottom: 28px;
  }

  .success-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* Summary sidebar */
  .checkout-summary {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    position: sticky;
    top: 90px;
  }

  .summary-title { font-size: 1rem; font-weight: 700; margin-bottom: 16px; }

  .co-summary-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .co-item-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  .co-item-info { flex: 1; }
  .co-item-name { font-size: 0.875rem; font-weight: 600; }
  .co-item-meta { font-size: 0.75rem; color: var(--text-muted); }
