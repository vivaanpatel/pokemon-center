---
import Layout from '../layouts/Layout.astro';
import { cards } from '../data/cards';
---

<Layout title="Shopping Cart — PokéCard Market" description="Review your selected Pokémon cards and proceed to checkout.">
  <div class="cart-page">
    <div class="container">
      <h1 class="page-title">🛒 Your Cart</h1>

      <div class="cart-layout" id="cart-layout">
        <!-- Cart Items -->
        <div class="cart-items-section">
          <div id="cart-items-list">
            <!-- Populated by JS -->
          </div>
          <div class="empty-cart" id="empty-cart" style="display:none">
            <div class="empty-icon">🃏</div>
            <h3>Your cart is empty</h3>
            <p>Discover rare Pokémon cards to add to your collection</p>
            <a href="/shop" class="btn btn-primary" style="margin-top:20px" id="go-shop-btn">Browse Cards</a>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="cart-summary" id="cart-summary">
          <h3 class="summary-title">Order Summary</h3>

          <div class="summary-rows">
            <div class="summary-row">
              <span>Subtotal</span>
              <span id="summary-subtotal">$0.00</span>
            </div>
            <div class="summary-row">
              <span>Shipping</span>
              <span id="summary-shipping">$0.00</span>
            </div>
            <div class="summary-row" id="discount-row" style="display:none">
              <span style="color: #22c55e">Discount</span>
              <span style="color: #22c55e" id="summary-discount">-$0.00</span>
            </div>
          </div>

          <div class="promo-section">
            <input type="text" id="promo-input" class="promo-input" placeholder="Promo code..." />
            <button class="btn btn-outline promo-btn" id="apply-promo">Apply</button>
          </div>
          <div class="promo-msg" id="promo-msg"></div>

          <div class="summary-total">
            <span>Total</span>
            <span id="summary-total">$0.00</span>
          </div>

          <a href="/checkout" class="btn btn-primary checkout-btn" id="checkout-btn">
            Proceed to Checkout
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <a href="/shop" class="continue-link" id="continue-shopping">← Continue Shopping</a>

          <div class="trust-badges" style="margin-top: 20px; flex-direction: column; gap: 10px; align-items: flex-start;">
            <div class="trust-item"><span>🔒</span><span>Secure Checkout</span></div>
            <div class="trust-item"><span>📦</span><span>Free Shipping Over $50</span></div>
            <div class="trust-item"><span>↩️</span><span>30-Day Returns</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ cardsData: cards }}>
  const PROMO_CODES = { 'POKEMON10': 10, 'TRAINER20': 20 };

  function renderCart() {
    const cart = JSON.parse(localStorage.getItem('pokemon-cart') || '[]');
    const list = document.getElementById('cart-items-list');
    const emptyCart = document.getElementById('empty-cart');
    const cartSummary = document.getElementById('cart-summary');
    const checkoutBtn = document.getElementById('checkout-btn');

    if (!list) return;

    if (cart.length === 0) {
      list.innerHTML = '';
      if (emptyCart) emptyCart.style.display = 'flex';
      if (cartSummary) cartSummary.style.display = 'none';
      return;
    }

    if (emptyCart) emptyCart.style.display = 'none';
    if (cartSummary) cartSummary.style.display = 'block';

    let subtotal = 0;
    list.innerHTML = cart.map(item => {
      const card = cardsData.find(c => c.id === item.id);
      if (!card) return '';
      const lineTotal = card.price * item.qty;
      subtotal += lineTotal;
      return `
        <div class="cart-item" id="cart-item-${card.id}">
          <a href="/card/${card.id}" class="cart-item-img-wrap">
            <img src="${card.image}" alt="${card.name}" class="cart-item-img" />
          </a>
          <div class="cart-item-info">
            <a href="/card/${card.id}" class="cart-item-name">${card.name}</a>
            <div class="cart-item-meta">${card.set} • ${card.rarity} • ${card.condition}</div>
            <div class="cart-item-price-row">
              <div class="cart-item-qty">
                <button class="qty-btn" onclick="changeQty('${card.id}', -1)">−</button>
                <span>${item.qty}</span>
                <button class="qty-btn" onclick="changeQty('${card.id}', 1)">+</button>
              </div>
              <div class="cart-item-line">$${lineTotal.toFixed(2)}</div>
              <button class="remove-btn" onclick="removeItem('${card.id}')" aria-label="Remove ${card.name}">✕</button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    updateSummary(subtotal);
  }

  let appliedDiscount = 0;

  function updateSummary(subtotal) {
    const shipping = subtotal >= 50 ? 0 : 4.99;
    const discountAmt = subtotal * (appliedDiscount / 100);
    const total = subtotal - discountAmt + shipping;

    document.getElementById('summary-subtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('summary-shipping').textContent = shipping === 0 ? 'FREE' : `$${shipping.toFixed(2)}`;
    document.getElementById('summary-total').textContent = `$${total.toFixed(2)}`;

    const discountRow = document.getElementById('discount-row');
    if (appliedDiscount > 0) {
      discountRow.style.display = 'flex';
      document.getElementById('summary-discount').textContent = `-$${discountAmt.toFixed(2)}`;
    } else {
      discountRow.style.display = 'none';
    }
  }

  function changeQty(cardId, delta) {
    const cart = JSON.parse(localStorage.getItem('pokemon-cart') || '[]');
    const idx = cart.findIndex(i => i.id === cardId);
    if (idx < 0) return;
    cart[idx].qty = Math.max(1, cart[idx].qty + delta);
    localStorage.setItem('pokemon-cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
    renderCart();
  }

  function removeItem(cardId) {
    const cart = JSON.parse(localStorage.getItem('pokemon-cart') || '[]');
    const updated = cart.filter(i => i.id !== cardId);
    localStorage.setItem('pokemon-cart', JSON.stringify(updated));
    window.dispatchEvent(new Event('cart-updated'));
    renderCart();
  }

  // Apply promo
  document.getElementById('apply-promo')?.addEventListener('click', () => {
    const code = document.getElementById('promo-input').value.trim().toUpperCase();
    const msg = document.getElementById('promo-msg');
    if (PROMO_CODES[code]) {
      appliedDiscount = PROMO_CODES[code];
      msg.textContent = `✓ Code applied! ${appliedDiscount}% off`;
      msg.style.color = '#22c55e';
    } else {
      msg.textContent = '✗ Invalid promo code';
      msg.style.color = '#FF6B6B';
    }
    renderCart();
  });

  // Global
  window.changeQty = changeQty;
  window.removeItem = removeItem;

  renderCart();
  window.addEventListener('cart-updated', renderCart);
  function addToCart(cardId) {
    const cart = JSON.parse(localStorage.getItem('pokemon-cart') || '[]');
    const idx = cart.findIndex(i => i.id === cardId);
    if (idx >= 0) cart[idx].qty += 1;
    else cart.push({ id: cardId, qty: 1 });
    localStorage.setItem('pokemon-cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
  }
  window.addToCart = addToCart;
</script>

<style>
  .cart-page { padding-top: 100px; padding-bottom: 80px; min-height: 100vh; }

  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: 36px;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 32px;
    align-items: start;
  }

  /* Cart Items */
  .cart-items-section { display: flex; flex-direction: column; gap: 16px; }

  .cart-item {
    display: flex;
    gap: 20px;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: border-color var(--transition);
  }

  .cart-item:hover { border-color: rgba(255,215,0,0.2); }

  .cart-item-img-wrap {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .cart-item-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
    transition: transform 0.3s ease;
  }

  .cart-item-img-wrap:hover .cart-item-img { transform: scale(1.1); }

  .cart-item-info { flex: 1; display: flex; flex-direction: column; gap: 6px; }

  .cart-item-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--white);
    transition: color var(--transition);
  }

  .cart-item-name:hover { color: var(--yellow); }

  .cart-item-meta { font-size: 0.8rem; color: var(--text-muted); }

  .cart-item-price-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0 4px;
  }

  .qty-btn {
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    color: var(--white);
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background var(--transition);
  }

  .qty-btn:hover { background: rgba(255,255,255,0.1); }

  .cart-item-qty span { min-width: 24px; text-align: center; font-weight: 700; }

  .cart-item-line { font-size: 1.05rem; font-weight: 800; color: var(--yellow); }

  .remove-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
    border-radius: 4px;
    transition: color var(--transition);
    margin-left: auto;
  }

  .remove-btn:hover { color: #FF6B6B; }

  /* Empty */
  .empty-cart {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 24px;
  }

  .empty-icon { font-size: 4rem; margin-bottom: 16px; }
  .empty-cart h3 { font-size: 1.3rem; font-weight: 700; margin-bottom: 8px; }
  .empty-cart p { color: var(--text-muted); }

  /* Summary */
  .cart-summary {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    position: sticky;
    top: 90px;
  }

  .summary-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; }

  .summary-rows { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-body);
  }

  .promo-section { display: flex; gap: 8px; margin-bottom: 8px; }

  .promo-input {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    color: var(--white);
    font-family: 'Outfit', sans-serif;
    font-size: 0.875rem;
    transition: border-color var(--transition);
  }

  .promo-input:focus { outline: none; border-color: rgba(255,215,0,0.5); }
  .promo-input::placeholder { color: var(--text-muted); }

  .promo-btn { padding: 10px 16px; border-radius: var(--radius-sm); font-size: 0.85rem; }

  .promo-msg { font-size: 0.8rem; margin-bottom: 12px; min-height: 18px; }

  .summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--white);
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-bottom: 20px;
  }

  .checkout-btn { width: 100%; justify-content: center; margin-bottom: 12px; }
  .continue-link {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .continue-link:hover { color: var(--yellow); }

  .trust-badges { display: flex; gap: 12px; }
  .trust-item { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .cart-layout { grid-template-columns: 1fr; }
    .cart-summary { position: static; }
  }

  @media (max-width: 600px) {
    .cart-item { flex-direction: column; }
    .cart-item-img-wrap { width: 80px; height: 80px; }
  }
</style>
